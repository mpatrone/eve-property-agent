{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "composite": true,
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    ".eve/**/*.d.ts",
    "drizzle.config.ts",
    "db/**/*.ts"
  ]
}
